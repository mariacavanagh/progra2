<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<head>
	<%- include("partials/head") %>
</head>
<body>
	<header>
		<%- include("partials/header")%>
	</header>
	
		<div class="banner">
		<img src="images/img-home-banner.jpg" alt="Banner de ofertas">
	</div>

	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Resultados de búsqueda</h2>
			</div>
			
            <% if (productos.length > 0) { %>
                <% productos.forEach(producto => { %>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <section class="product-box">
                            <a href="/product/<%= producto.id %>">
                                <figure class="product-box_image">
                                    <img src="/<%= producto.nombreArchivo %>" alt="<%= producto.nombreProducto %>">
                                </figure>
                                <article class="product-box_data">
                                    <h2><%= producto.nombreProducto %></h2>
                                    <p><%= producto.descripcionProducto %></p>
                                    <p>
                                        Subido por: 
                                        <% if (producto.usuario) { %>
                                          <a href="/profile/<%= producto.usuario.id %>">
                                            <%= producto.usuario.email %>
                                          </a>
                                        <% } else { %>
                                          <span>Desconocido</span>
                                        <% } %>
                                      </p>
                                </article>
                            </a>
                        </section>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12">
                    <p>No se encontraron resultados para tu búsqueda.</p> 
                </div>
            <% } %>
		
		</div>
	</div>
	
	<footer>
		<%- include("partials/footer") %>
	</footer>
	</body>	
</html>

