<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<head>
	<%- include("partials/head") %>
</head>
<body>
	<header>
		<% if (usuarioLogueado){ %>
			<%- include("partials/headerLogueado", { usuario: usuarioLogueado }) %>
		<% } else { %>
			<%- include("partials/header")%>
		<% } %>
		
	</header>
	
		<div class="banner">
		<img src="images/bannerrecortado.png" alt="Banner de ofertas">
	</div>

	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Productos</h2>
			</div>
			<% for (let i = 0; i < productos.length; i++) { %>
				
				<div class="col-12 col-sm-6 col-lg-3">
					<section class="product-box">
						<a href="/product/<%= productos[i].id %>">
							<figure class="product-box_image">
								<img src="/images/products/<%= productos[i].nombreArchivo %>" alt="Imagen del producto">							</figure>
							<article class="product-box_data">
								<h2><%= productos[i].nombreProducto %></h2>
								<p>Descripción: <%= productos[i].descripcionProducto %></p>
								<p>Comentarios: <%= productos[i].comentarios.length %></p>
								<p>Subido por:
									<% if (productos[i].usuario) { %>
									  <a href="/profile/<%= producto.usuario.id %>">
										  <%= producto.usuario.email %>
									  </a>
									<% } else { %>
									  <span>Desconocido</span>
									<% } %>
								</p>
							</article>
						</a>
					</section>
				</div>
				<% } %>
		
		</div>
	</div>
	
	<footer>
		<%- include("partials/footer") %>
	</footer>
	</body>	
</html>

