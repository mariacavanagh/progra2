<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<head>
	<%- include("partials/head") %>
</head>
<body>
	<header>
		<%- include("partials/header")%>
	</header>
	
		<div class="banner">
		<img src="images/img-home-banner.jpg" alt="Banner de ofertas">
	</div>

	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Productos</h2>
			</div>
			<% for (let i = 0; i < productos.length; i++) { %>
				
				<div class="col-12 col-sm-6 col-lg-3">
					<section class="product-box">
						<a href="/product">
							<figure class="product-box_image">
								<img src="<%=productos[i].imagen %>" alt="cafetera moulinex">
							</figure>
							<article class="product-box_data">
								<h2><%= productos[i].nombre %></h2>
								<p><%= productos[i].descripcion %></p>
								<% for (let a = 0; a < productos[i].comentarios.length; a++) { %>
									<p><%= productos[i].comentarios[a].comentario %></p>
								<%} %>
							</article>
						</a>
					</section>
				</div>
			<% } %>
		
			
		</div>
	</div>
	
	<footer>
		<%- include("partials/footer") %>
	</footer>
	</body>	
</html>

