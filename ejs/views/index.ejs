<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<head>
	<%- include("partials/head") %>
</head>
<body>
	<header>
		<%- include("partials/header")%>
	</header>
	
		<div class="banner">
		<img src="images/bannerrecortado.png" alt="Banner de ofertas">
	</div>

	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Productos</h2>
			</div>
			<% for (let i = 0; i < productos.length; i++) { %>
				
				<div class="col-12 col-sm-6 col-lg-3">
					<section class="product-box">
						<a href="/product/<%= productos[i].id %>">
							<figure class="product-box_image">
								<img src="/<%=productos[i].nombreArchivo %>" alt="cafetera moulinex">
							</figure>
							<article class="product-box_data">
								<h2><%= productos[i].nombre %></h2>
								<p>Descripción: <%= productos[i].descripcion %></p>
								<p>Comentarios: <%= productos[i].comentarios.length %></p>
							</article>
						</a>
					</section>
				</div>
				<% } %>
		
		</div>
	</div>
	
	<footer>
		<%- include("partials/footer") %>
	</footer>
	</body>	
</html>

