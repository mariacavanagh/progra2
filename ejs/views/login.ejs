				<label for="recordarme">
					<input type="checkbox" id="recordarme" name="recordarme" value="true">
					Recordarme
				  </label>
				
				<button type="submit">Ingresar</button>

			</form>
		<footer>
			<%- include("partials/footer") %>
		</footer>
</body>

</html>


