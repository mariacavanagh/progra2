<!DOCTYPE html>
<html lang="es">
<head>
	<%- include("partials/head") %>
</head>
<body>
	<!-- Header -->
	<header>
		<%- include('partials/header') %>
	</header>
	<!-- /Header -->

	<!-- product detail -->
	<div class="container products-wrapper">
		<div class="d-flex align-items-center">
			<h2 class="products-title"> <%= product.nombre %> </h2> 
			<p class="product-detail-description">
				<a href="/product">Editar</a>
			</p>
		</div>
		<div class="product-detail">
			<div class="row">
				<article class="col-12 col-lg-8 product-detail-info">
					<img src="/images/products/<%= product.imagen %>" alt="" class="product-detail-img">
					<p class="product-detail-description">
					<%= product.descripcion %>	
					</p>
				</article>
				<div class="col-12 col-lg-4">
					<section class="comments">
						<% for (let i = 0; i < product.comentarios.length; i++) { %>		
							<article> 
								<img src="<%=product.comentarios[i].imagen%>" alt="">
								<div class="data">
									<p class="user">
									<strong> <a href="/profile"> <%= product.comentarios[i].nombre %> </a> </strong>
									<%= product.comentarios[i].comentario %>
									</p>
								</div>
							</article>
						<% } %>
						
					</section>
					<form class="form" action="" method="POST">
						<input class="form-input" type="text" value="" placeholder="Agregar comentario">
						<button type="submit" class="buy-now-button">AGREGAR COMENTARIO</button>
					</form>
					<hr>
				</div>
			</div>
		</div>
	</div>
	<!-- /product detail -->

	<!-- footer -->
	<footer>
		<%- include('partials/footer') %>
	</footer>
	<!-- /footer -->

</body>	
</html>