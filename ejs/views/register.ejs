<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include("partials/head") %>

<body>
	<!-- Header -->
	<header>
		<%- include("partials/header") %>
	</header>
	<!-- /Header -->

	<!-- Novedades -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Registrate</h2>
			</div>
			<!-- Show the "ultimos" products -->
			<form action="/registrarse" method="POST">
				<label for="email">Email:</label>
				<input type="email" id="email" name="email" required><br>
			  
				<label for="usuario">Nombre de usuario:</label>
				<input type="text" id="usuario" name="usuario" required><br>
			  
				<label for="contraseña">Contraseña:</label>
				<input type="password" id="contraseña" name="contraseña" required><br>
			  
				<label for="fecha_nacimiento">Fecha de nacimiento:</label>
				<input type="date" id="fecha_nacimiento" name="fecha_nacimiento" required><br>
			  
				<label for="dni">Número de documento:</label>
				<input type="number" id="dni" name="dni" required><br>
			  
				<label for="foto_perfil">Foto de perfil (URL):</label>
				<input type="text" id="foto_perfil" name="foto_perfil"><br>
			  
				<button type="submit">Registrarse</button>
			  </form>


	<!-- footer -->
	<footer>
		<%- include("partials/footer") %>
	</footer>
	<!-- /footer -->
</body>

</html>